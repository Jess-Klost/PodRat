<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:RSSPod.ViewModels"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            x:Class="RSSPod.Views.FeedAdder"
            x:DataType="vm:FeedAdderViewModel">
    <UserControl.DataContext>
        <vm:FeedAdderViewModel />    
    </UserControl.DataContext>

    <StackPanel>
        <Label Target="AddFeedNameBox" Content="Name" />
        <TextBox Name="AddFeedNameBox" Width="150" Margin="5" Text="{Binding Name}" />
        <Label Target="AddFeedRSSBox" Content="RSS Link" />
        <TextBox Name="AddFeedRSSBox" Width="150" Margin="5" Text="{Binding Uri}" />
        <Button Command="{Binding AddFeedCommand}" HorizontalAlignment="Right" Margin="5">Add</Button>
    </StackPanel>
</UserControl>