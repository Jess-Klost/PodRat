<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RSSPod.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:dialogs="using:Avalonia.Dialogs"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
        xmlns:local="clr-namespace:RSSPod;assembly=RSSPod"
        xmlns:views="clr-namespace:RSSPod.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RSSPod.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="RSSPod"
        Width="800"
        Height="600">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <local:IsDownloadedToIconConverter x:Key="IsDownloadedConverter" />
        <local:TimeFormatConverter x:Key="TimeFormatConverter" />
        <local:HTMLConverter x:Key="HTMLConverter" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ToggleButton PathIcon.playing">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ToggleButton:checked PathIcon.playing">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="ToggleButton PathIcon.paused">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="ToggleButton:checked PathIcon.paused">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </Window.Styles>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <StackPanel Name="FeedControls" Orientation="Horizontal"  DockPanel.Dock="Top">
                <ComboBox ItemsSource="{Binding UserData.PodcastFeeds}" 
                    PlaceholderText="Podcast Feed"
                    SelectionChanged="FeedSelector_OnChange">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Add Feed"  Name="AddFeedPopupButton" >
                    <Button.Flyout>
                        <Flyout Closed="AddFeed_Closed">
                            <StackPanel>
                                <views:FeedAdder Name="FeedAdderFlyout" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>    
                </Button>
                <Button> 
                    <PathIcon Data="{StaticResource options_regular}" Width="15" 
                            Height="15" HorizontalAlignment="Center"/>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Delete" Click="RemoveFeed_OnClick"></MenuItem>    
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <ScrollViewer DockPanel.Dock="Bottom">
                <ItemsControl ItemsSource="{Binding CurrentFeed}" Name="FeedViewer">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="16" Padding="12,6" Margin="4">
                                <StackPanel Orientation="Horizontal">
                                    <Expander Width="330" ToolTip.Tip="{Binding Item.Title.Text}">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding Item.Title.Text}" MaxWidth="270" TextTrimming="CharacterEllipsis"/>
                                        </Expander.Header>
                                        <StackPanel>
                                                <Button Name="DeleteButton" Tag="{Binding Item.Id}" Click="DeleteItem_OnClick">Delete</Button>
                                                <SelectableTextBlock Text="{Binding Item.Summary.Text, Converter={StaticResource HTMLConverter}}" TextWrapping="WrapWithOverflow" />
                                        </StackPanel>
                                    </Expander>
                                    <Button VerticalAlignment="Top" Name="{Binding Item.Id}" Click="InteractItem_OnClick">
                                        <StackPanel>
                                        <PathIcon Data="{Binding IsDownloaded^, Converter={StaticResource IsDownloadedConverter}}" 
                                            Width="20" Height="20" Margin="5"
                                            HorizontalAlignment="Center"/>
                                        <ProgressBar MinWidth="20" IsVisible="{Binding !IsDownloaded^}"></ProgressBar>
                                        </StackPanel>
                                    </Button> 
                                </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </DockPanel>
        <!-- Media Control -->
        <StackPanel Orientation="Vertical" Name="MediaControl" Grid.Column="1" VerticalAlignment="Bottom">
            <Image Margin="20" MaxHeight="300" MaxWidth="300" asyncImageLoader:ImageLoader.Source="{Binding ThumbnailLink}"/>
            <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" Margin="5"></TextBlock>
            <TextBlock Text="{Binding Author}" HorizontalAlignment="Center" Margin="5"></TextBlock>
            <StackPanel Margin="10">
                <Slider Name="PositionSlider" Value="{Binding Position}" Maximum="1" Minimum="0" ValueChanged="Position_OnValueChanged"></Slider>
                <Panel>
                    <TextBlock HorizontalAlignment="Left">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource TimeFormatConverter}">
                                <Binding Path="LengthMS" />
                                <Binding Path="Position" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource TimeFormatConverter}">
                                <Binding Path="LengthMS" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Panel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Click="Backward_OnClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource caret_left_regular}" Width="50" 
                            Height="50" Margin="5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <ToggleButton Name="PlayButton" Click="Play_OnClick">
                    <Panel>
                        <PathIcon Classes="paused" Data="{StaticResource play_regular}" Width="50" 
                            Height="50" Margin="5" 
                            HorizontalAlignment="Center" />
                        <PathIcon Classes="playing" Data="{StaticResource pause_regular}" Width="50" 
                            Height="50" Margin="5" 
                            HorizontalAlignment="Center" />
                    </Panel>
                </ToggleButton>
                <Button Click="Forward_OnClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource caret_right_regular}" Width="50" 
                            Height="50" Margin="5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button>
                    <Button.Flyout>
                        <Flyout ShowMode="TransientWithDismissOnPointerMoveAway" Placement="Top">
                            <Slider Orientation="Vertical" Value="50" Height="100" ValueChanged="Volume_OnValueChanged" Name="VolumeSlider"></Slider>    
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource speaker_regular}" Width="50" 
                            Height="50" Margin="5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
