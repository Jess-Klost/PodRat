<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:PodBat.ViewModels"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:PodBat;assembly=PodBat"
            xmlns:views="clr-namespace:PodBat.Views"
            xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
            x:Class="PodBat.Views.FeedViewer"
            x:DataType="vm:FeedViewerViewModel">
    <UserControl.DataContext>
        <vm:FeedViewerViewModel />    
    </UserControl.DataContext>

    <UserControl.Resources>
        <local:IsDownloadedToIconConverter x:Key="IsDownloadedConverter" />
        <local:TimeFormatConverter x:Key="TimeFormatConverter" />
        <local:HTMLConverter x:Key="HTMLConverter" />
        <local:CollectionIsNullOrEmpty x:Key="CollectionIsNullOrEmpty" />
        <local:CollectionHasElements x:Key="CollectionHasElements" />
        <local:StringConcatConverter x:Key="StringConcat" />
        <local:DateTimeShortDateConverter x:Key="ShortDate" />
        <local:DateTimeFullDateConverter x:Key="FullDate" />
        <local:BytesToMegabytesConverter x:Key="Megabytes" />
        <local:SubtractIfStringEmptyConverter x:Key="SubtractIfEmpty" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="FlyoutPresenter.large">
           <Setter Property="MinWidth" Value="400" />
           <Setter Property="MaxHeight" Value="400" />
       </Style>
    </UserControl.Styles>

    <Grid> 
        <DockPanel>
            <StackPanel Name="FeedControls" Orientation="Horizontal"  DockPanel.Dock="Top">
                <Button Click="BackButton_OnClick" ToolTip.Tip="Back">
                    <PathIcon Data="{StaticResource arrow_left_regular}" Width="15" 
                            Height="15" HorizontalAlignment="Center"/>
                </Button>
                <ComboBox Name="FeedSelector"
                    ItemsSource="{Binding UserData.PodcastFeeds}" 
                    PlaceholderText="Podcast Feed"
                    SelectionChanged="FeedSelector_OnChange">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Add Feed"  Name="AddFeedPopupButton" >
                    <Button.Flyout>
                        <Flyout Closed="AddFeed_Closed">
                            <StackPanel>
                                <views:FeedAdder Name="FeedAdderFlyout" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>    
                </Button>
                <Button> 
                    <PathIcon Data="{StaticResource options_regular}" Width="15" 
                            Height="15" HorizontalAlignment="Center"/>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Edit Feed" Click="EditFeed_OnClick" />
                            <MenuItem Header="Delete Feed" Click="RemoveFeed_OnClick" /> 
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <Panel DockPanel.Dock="Bottom">
                <TextBlock Text="No feed to display." Foreground="{DynamicResource BaseMediumLow}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="CurrentFeed" Converter="{StaticResource CollectionIsNullOrEmpty}" />
                            <Binding Path="!CurrentFeedLoading" />
                            <Binding Path="CurrentFeedValid" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
                <StackPanel IsVisible="{Binding CurrentFeedLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="Loading Feed" Foreground="{DynamicResource BaseMediumLow}" TextAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Width="50" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!CurrentFeedLoading" />
                                <Binding Path="!CurrentFeedValid" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <TextBlock Foreground="{DynamicResource BaseMediumLow}">Could not find a RSS feed at this URL.</TextBlock>
                </StackPanel>
                <ScrollViewer>
                    <ScrollViewer.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="CurrentFeed" Converter="{StaticResource CollectionHasElements}" />
                            <Binding Path="!CurrentFeedLoading" />
                        </MultiBinding>
                    </ScrollViewer.IsVisible>
                    <ListBox ItemsSource="{Binding CurrentFeed}" Name="FeedList" SelectionChanged="FeedList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="16" Padding="12,6" Margin="4">
                                    <Grid ColumnSpacing="8" Name="{Binding Item.Id, Converter={StaticResource StringConcat}, ConverterParameter=ListItem}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Image HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Height="50" Width="50"
                                            Grid.RowSpan="2"
                                            IsVisible="{Binding ThumbnailLink, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            asyncImageLoader:ImageLoader.Source="{Binding ThumbnailLink}"/>
                                        <TextBlock Text="{Binding Item.Title.Text}" 
                                            TextTrimming="WordEllipsis"
                                            ToolTip.Tip="{Binding Item.Title.Text}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextWrapping="WrapWithOverflow"
                                            MaxHeight="50"
                                            Grid.Row="0" 
                                            Grid.Column="{Binding ThumbnailLink,
                                                Converter={StaticResource SubtractIfEmpty}, 
                                                ConverterParameter=1}" 
                                            Grid.ColumnSpan="2" />
                                        <TextBlock Text="{Binding Item.PublishDate, Converter={StaticResource ShortDate}}"
                                            Foreground="{DynamicResource BaseMediumHigh}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding Item.PublishDate, Converter={StaticResource FullDate}}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Grid.Row="1" 
                                            Grid.Column="{Binding ThumbnailLink,
                                                Converter={StaticResource SubtractIfEmpty}, 
                                                ConverterParameter=1}" />
                                        <TextBlock Text="{Binding Duration}"
                                            Foreground="{DynamicResource BaseMediumHigh}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding Duration}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Grid.Row="1" Grid.Column="2"/>
                                        <Button VerticalAlignment="Top" 
                                            Name="{Binding Item.Id}"
                                            Click="InteractItem_OnClick"
                                            PointerEntered="InteractItem_PointerEntered"
                                            PointerExited="InteractItem_PointerExited"
                                            Grid.Column="3" Grid.RowSpan="2"
                                            IsVisible="{Binding HasAudio}">
                                            <StackPanel>
                                            <PathIcon Data="{Binding IsDownloaded^, Converter={StaticResource IsDownloadedConverter}}" 
                                                Width="20" Height="20" Margin="5"
                                                HorizontalAlignment="Center"/>
                                            <ProgressBar 
                                                Tag="DownloadProgressBar"
                                                MinWidth="20"
                                                IsVisible="{Binding !IsDownloaded^}"
                                                Background="{DynamicResource BaseMediumLow}" />
                                            <ProgressBar 
                                                Tag="ListenDataProgressBar"
                                                MinWidth="20" 
                                                IsVisible="{Binding IsDownloaded^}"
                                                Background="{DynamicResource BaseMediumLow}"
                                                Value="{Binding ListenDataPosition}"
                                                Minimum="0"
                                                Maximum="1" />
                                            </StackPanel>
                                        </Button> 
                                        <FlyoutBase.AttachedFlyout>
                                            <Flyout FlyoutPresenterClasses="large" ShowMode="TransientWithDismissOnPointerMoveAway">
                                                <StackPanel Spacing="8" MaxWidth="300">
                                                    <Button Name="DeleteButton" 
                                                        Tag="{Binding Item.Id}" 
                                                        Click="DeleteItem_OnClick"
                                                        IsVisible="{Binding IsDownloaded^}">
                                                        Delete
                                                    </Button>
                                                    <TextBlock Foreground="{DynamicResource BaseMediumHigh}"
                                                        IsVisible="{Binding HasAudio}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} MB">
                                                                <Binding Path="FileSize" Converter="{StaticResource Megabytes}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <SelectableTextBlock Text="{Binding Item.Summary.Text, Converter={StaticResource HTMLConverter}}" TextWrapping="WrapWithOverflow" />
                                                </StackPanel>
                                            </Flyout>
                                        </FlyoutBase.AttachedFlyout>
                                    </Grid> 
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Panel>
        </DockPanel>
        <Border Name="PopupBackground" IsVisible="{Binding EditFeedPopupVisible}" Background="#40000000">
            <Popup IsOpen="{Binding EditFeedPopupVisible}"
                    Placement="Center">
                <Border Background="Black" Padding="16" CornerRadius="4"
                        BoxShadow="0 2 8 0 #40000000">
                    <views:FeedEditor Name="FeedEditorControl" />
                </Border>
            </Popup>
        </Border>  
    </Grid>
</UserControl>