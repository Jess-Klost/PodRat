{
    "GeneralSettings": {
        "NetProjectPath": "PodRat.csproj",
        "PackageName": {
            "$type": "msbuild",
            "property": "PodRat"
        },
        "AssemblyName": {
            "$type": "msbuild",
            "property": "AssemblyName"
        },
        "ApplicationName": "PodRat",
        "Version": "1.0.0",
        "Icon": "Assets/podrat.ico",
        "Company": "Jess Klost"
    },
    "LinuxSettings": {
        "AppIcon": "Assets/podrat.png",
        "Maintainer": "",
        "CopyrightFile": "LICENSE.md",
        "DesktopCategory": "Audio",
        "CreateBinSymlink": "True",
        "AdditionalDebDependencies": [
            "libvlc-dev",
            "vlc"
        ]
    },
    "Win32Settings": {
        "IncludeUninstaller": "True"
    },
    "MacOsSettings": {
        "CreateBundle": true,
        "BundleIdentifier": "com.CompanyName.PodBat",
        "SigningCredentialsType": "AdHoc"
    },
    "PublishSettings": {
        "PublishSingleFile": "True",
        "ExtraBuildProperties": {}
    }
}